<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="main-content">
        <div class="container">
            <div class="card" style="max-width: 650px; margin: 32px auto; text-align: center; padding: 48px 32px;">
                <div style="width: 72px; height: 72px; background: #ecfdf5; color: #10b981; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; margin: 0 auto 20px;">
                    ✓
                </div>

                <h1 style="font-size: 1.85rem; margin-bottom: 8px;">Thank You for Your Order!</h1>
                <p style="color: var(--gray-600); margin-bottom: 24px;">
                    Your order has been placed successfully. A confirmation summary has been registered in your account.
                </p>

                <div style="background: var(--gray-50); border: 1px solid var(--gray-200); border-radius: var(--radius-md); padding: 20px; text-align: left; margin-bottom: 28px;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <span style="color: var(--gray-500);">Order Number:</span>
                        <strong>#<%= order._id.toString().toUpperCase() %></strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <span style="color: var(--gray-500);">Payment Method:</span>
                        <span><%= order.paymentMethod %></span>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <span style="color: var(--gray-500);">Payment Status:</span>
                        <span class="status-pill status-<%= order.paymentStatus %>"><%= order.paymentStatus %></span>
                    </div>
                    <div style="display: flex; justify-content: space-between; border-top: 1px solid var(--gray-200); padding-top: 8px; font-weight: 700;">
                        <span>Total Paid:</span>
                        <span style="color: var(--primary);">₹<%= order.totalAmount.toFixed(2) %></span>
                    </div>
                </div>

                <div style="display: flex; gap: 16px; justify-content: center;">
                    <a href="/orders/<%= order._id %>" class="btn btn-primary" id="btn-view-order-details">View Order Details</a>
                    <a href="/products" class="btn btn-secondary">Continue Shopping</a>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
