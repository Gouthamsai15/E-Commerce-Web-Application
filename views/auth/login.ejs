<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/auth.css" />
</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="main-content">
        <div class="container">
            <div class="auth-wrapper">
                <div class="auth-card">
                    <div class="auth-header">
                        <h1>Welcome Back</h1>
                        <p>Sign in to your ModernShop account</p>
                    </div>

                    <div class="flash-container">
                        <%- include('../partials/messages') %>
                    </div>

                    <form action="/auth/login<%= typeof redirectUrl !== 'undefined' && redirectUrl ? '?redirect=' + encodeURIComponent(redirectUrl) : '' %>" method="POST" id="login-form">
                        <input type="hidden" name="redirectUrl" value="<%= typeof redirectUrl !== 'undefined' ? redirectUrl : '' %>" />

                        <div class="form-group">
                            <label for="email" class="form-label">Email Address</label>
                            <input 
                                type="email" 
                                id="email" 
                                name="email" 
                                class="form-control" 
                                placeholder="name@example.com" 
                                value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
                                required 
                            />
                        </div>

                        <div class="form-group">
                            <label for="password" class="form-label">Password</label>
                            <input 
                                type="password" 
                                id="password" 
                                name="password" 
                                class="form-control" 
                                placeholder="••••••••" 
                                required 
                            />
                        </div>

                        <button type="submit" class="btn btn-primary btn-block" id="btn-login-submit" style="margin-top: 12px;">
                            Sign In
                        </button>
                    </form>

                    <div class="auth-links">
                        <p>Don't have an account? <a href="/auth/register" id="link-to-register">Create an account</a></p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
