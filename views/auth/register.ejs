<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/auth.css" />
</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="main-content">
        <div class="container">
            <div class="auth-wrapper">
                <div class="auth-card">
                    <div class="auth-header">
                        <h1>Create Account</h1>
                        <p>Sign up to start shopping on ModernShop</p>
                    </div>

                    <div class="flash-container">
                        <%- include('../partials/messages') %>
                    </div>

                    <form action="/auth/register" method="POST" id="register-form">
                        <div class="form-group">
                            <label for="name" class="form-label">Full Name</label>
                            <input 
                                type="text" 
                                id="name" 
                                name="name" 
                                class="form-control" 
                                placeholder="John Doe" 
                                value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>"
                                required 
                            />
                        </div>

                        <div class="form-group">
                            <label for="email" class="form-label">Email Address</label>
                            <input 
                                type="email" 
                                id="email" 
                                name="email" 
                                class="form-control" 
                                placeholder="you@example.com" 
                                value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
                                required 
                            />
                        </div>

                        <div class="form-group">
                            <label for="password" class="form-label">Password (Min. 6 characters)</label>
                            <input 
                                type="password" 
                                id="password" 
                                name="password" 
                                class="form-control" 
                                placeholder="••••••••" 
                                minlength="6"
                                required 
                            />
                        </div>

                        <div class="form-group">
                            <label for="confirmPassword" class="form-label">Confirm Password</label>
                            <input 
                                type="password" 
                                id="confirmPassword" 
                                name="confirmPassword" 
                                class="form-control" 
                                placeholder="••••••••" 
                                minlength="6"
                                required 
                            />
                        </div>

                        <button type="submit" class="btn btn-primary btn-block" id="btn-register-submit" style="margin-top: 12px;">
                            Register Account
                        </button>
                    </form>

                    <div class="auth-links">
                        <p>Already have an account? <a href="/auth/login" id="link-to-login">Sign In</a></p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
