<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="main-content">
        <div class="container">
            <div class="flash-container">
                <%- include('../partials/messages') %>
            </div>

            <h1 style="margin-bottom: 24px;">Your Shopping Cart</h1>

            <% if (items && items.length > 0) { %>
                <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 32px; align-items: start;">
                    <!-- Cart Items Table -->
                    <div class="card" style="padding: 0; overflow: hidden;">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Price</th>
                                    <th>Quantity</th>
                                    <th>Subtotal</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% items.forEach(item => { %>
                                    <tr>
                                        <td>
                                            <div style="display: flex; align-items: center; gap: 14px;">
                                                <img 
                                                    src="<%= (item.product.images && item.product.images.length > 0) ? item.product.images[0] : 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=100&auto=format&fit=crop&q=80' %>" 
                                                    alt="<%= item.product.name %>" 
                                                    style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px;"
                                                />
                                                <div>
                                                    <a href="/products/<%= item.product._id %>" style="font-weight: 600; color: var(--gray-900);">
                                                        <%= item.product.name %>
                                                    </a>
                                                    <div style="font-size: 0.8rem; color: var(--gray-500);">
                                                        Available Stock: <%= item.product.stock %>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td style="font-weight: 600;">₹<%= item.price.toFixed(2) %></td>
                                        <td>
                                            <!-- Update Quantity Form -->
                                            <form action="/cart/update" method="POST" style="display: flex; gap: 6px; align-items: center;">
                                                <input type="hidden" name="itemId" value="<%= item.id %>" />
                                                <input 
                                                    type="number" 
                                                    name="quantity" 
                                                    value="<%= item.quantity %>" 
                                                    min="1" 
                                                    max="<%= item.product.stock %>" 
                                                    class="form-control" 
                                                    style="width: 65px; padding: 4px 8px;"
                                                />
                                                <button type="submit" class="btn btn-secondary btn-sm" title="Update">↻</button>
                                            </form>
                                        </td>
                                        <td style="font-weight: 700; color: var(--primary);">₹<%= item.subtotal.toFixed(2) %></td>
                                        <td>
                                            <!-- Remove Item Form -->
                                            <form action="/cart/remove" method="POST">
                                                <input type="hidden" name="itemId" value="<%= item.id %>" />
                                                <button type="submit" class="btn btn-danger btn-sm" title="Remove" style="padding: 4px 10px;">✕</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Order Summary Box -->
                    <div class="card">
                        <h2 style="font-size: 1.25rem; margin-bottom: 20px; border-bottom: 1px solid var(--gray-200); padding-bottom: 12px;">
                            Order Summary
                        </h2>

                        <div style="display: flex; justify-content: space-between; margin-bottom: 12px; color: var(--gray-600);">
                            <span>Subtotal</span>
                            <span style="font-weight: 600; color: var(--gray-900);">₹<%= subtotal.toFixed(2) %></span>
                        </div>

                        <div style="display: flex; justify-content: space-between; margin-bottom: 16px; color: var(--gray-600);">
                            <span>Shipping</span>
                            <span style="font-weight: 600; color: #10b981;">FREE</span>
                        </div>

                        <div style="display: flex; justify-content: space-between; font-size: 1.25rem; font-weight: 800; border-top: 1px solid var(--gray-200); padding-top: 16px; margin-bottom: 24px;">
                            <span>Total</span>
                            <span style="color: var(--primary);">₹<%= total.toFixed(2) %></span>
                        </div>

                        <a href="/checkout/address" class="btn btn-primary btn-block" style="padding: 12px;" id="btn-proceed-checkout">
                            Proceed to Checkout &rarr;
                        </a>

                        <div style="text-align: center; margin-top: 16px;">
                            <a href="/products" style="font-size: 0.9rem; color: var(--gray-500);">&larr; Continue Shopping</a>
                        </div>
                    </div>
                </div>
            <% } else { %>
                <div class="card" style="text-align: center; padding: 64px 20px;">
                    <div style="font-size: 3rem; margin-bottom: 12px;">🛒</div>
                    <h2>Your cart is empty</h2>
                    <p style="color: var(--gray-500); margin: 12px 0 24px;">Looks like you haven't added anything to your cart yet.</p>
                    <a href="/products" class="btn btn-primary">Start Shopping Now</a>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
