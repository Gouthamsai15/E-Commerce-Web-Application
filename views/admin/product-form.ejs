<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/admin.css" />
    <link rel="stylesheet" href="/css/auth.css" />
</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="main-content">
        <div class="container">
            <div class="flash-container">
                <%- include('../partials/messages') %>
            </div>

            <div class="admin-layout">
                <!-- Sidebar -->
                <aside class="admin-sidebar">
                    <ul class="admin-menu">
                        <li class="admin-menu-item"><a href="/admin" class="admin-menu-link">📊 Dashboard</a></li>
                        <li class="admin-menu-item"><a href="/admin/products" class="admin-menu-link active">📦 Products</a></li>
                        <li class="admin-menu-item"><a href="/admin/categories" class="admin-menu-link">📁 Categories</a></li>
                        <li class="admin-menu-item"><a href="/admin/orders" class="admin-menu-link">🛍️ Orders</a></li>
                        <li class="admin-menu-item"><a href="/admin/users" class="admin-menu-link">👥 Users</a></li>
                    </ul>
                </aside>

                <!-- Content Form -->
                <div class="admin-main">
                    <div class="card" style="max-width: 800px;">
                        <h1 style="font-size: 1.5rem; margin-bottom: 24px; border-bottom: 1px solid var(--gray-200); padding-bottom: 12px;">
                            <%= isEdit ? 'Edit Product' : 'Create New Product' %>
                        </h1>

                        <form 
                            action="<%= isEdit ? `/admin/products/${product._id}/update` : '/admin/products' %>" 
                            method="POST"
                            id="admin-product-form"
                        >
                            <div class="form-group">
                                <label for="name" class="form-label">Product Name</label>
                                <input 
                                    type="text" 
                                    id="name" 
                                    name="name" 
                                    class="form-control" 
                                    value="<%= product.name || '' %>" 
                                    placeholder="e.g. Wireless Noise-Cancelling Headphones"
                                    required 
                                />
                            </div>

                            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px;">
                                <div class="form-group">
                                    <label for="price" class="form-label">Price (₹ INR)</label>
                                    <input 
                                        type="number" 
                                        id="price" 
                                        name="price" 
                                        step="0.01" 
                                        min="0" 
                                        class="form-control" 
                                        value="<%= product.price !== undefined ? product.price : '' %>" 
                                        placeholder="499.00"
                                        required 
                                    />
                                </div>

                                <div class="form-group">
                                    <label for="stock" class="form-label">Stock Quantity</label>
                                    <input 
                                        type="number" 
                                        id="stock" 
                                        name="stock" 
                                        min="0" 
                                        class="form-control" 
                                        value="<%= product.stock !== undefined ? product.stock : 10 %>" 
                                        required 
                                    />
                                </div>

                                <div class="form-group">
                                    <label for="category" class="form-label">Category</label>
                                    <select name="category" id="category" class="form-control" required>
                                        <option value="">Select Category</option>
                                        <% categories.forEach(cat => { %>
                                            <option 
                                                value="<%= cat._id %>"
                                                <%= (product.category && (product.category._id || product.category).toString() === cat._id.toString()) ? 'selected' : '' %>
                                            >
                                                <%= cat.name %>
                                            </option>
                                        <% }) %>
                                    </select>
                                </div>
                            </div>

                            <div class="form-group">
                                <label for="description" class="form-label">Product Description</label>
                                <textarea 
                                    name="description" 
                                    id="description" 
                                    rows="5" 
                                    class="form-control" 
                                    placeholder="Detailed product specifications, key features..."
                                    required
                                ><%= product.description || '' %></textarea>
                            </div>

                            <div class="form-group">
                                <label for="imageUrl" class="form-label">Product Image URL</label>
                                <input 
                                    type="url" 
                                    id="imageUrl" 
                                    name="imageUrl" 
                                    class="form-control" 
                                    value="<%= (product.images && product.images.length > 0) ? product.images[0] : '' %>" 
                                    placeholder="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&auto=format&fit=crop&q=80"
                                    autocomplete="off"
                                />
                                <small style="display: block; color: var(--gray-500); margin-top: 6px; font-size: 0.85rem;">
                                    Paste any direct image link from the web (e.g. Unsplash, Amazon, Pexels, Imgur, etc.). The image loads automatically across the storefront.
                                </small>

                                <!-- Live Image Preview Container -->
                                <div style="margin-top: 14px; padding: 14px; background: var(--gray-50); border: 1px dashed var(--gray-300); border-radius: var(--radius-sm);">
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                                        <span style="font-size: 0.85rem; font-weight: 600; color: var(--gray-700);">Live Image Preview:</span>
                                        <span id="preview-status" style="font-size: 0.8rem; color: var(--gray-500);"></span>
                                    </div>
                                    <div style="display: flex; gap: 16px; align-items: center;">
                                        <div style="width: 110px; height: 110px; border-radius: 8px; overflow: hidden; background: #e2e8f0; display: flex; align-items: center; justify-content: center; border: 1px solid var(--gray-200); flex-shrink: 0;">
                                            <img 
                                                id="img-preview" 
                                                src="<%= (product.images && product.images.length > 0) ? product.images[0] : 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500&auto=format&fit=crop&q=80' %>" 
                                                alt="Preview" 
                                                style="width: 100%; height: 100%; object-fit: cover;"
                                                onerror="this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500&auto=format&fit=crop&q=80'; document.getElementById('preview-status').innerText='(Using default placeholder)';"
                                                onload="if (this.src && !this.src.includes('1523275335684')) document.getElementById('preview-status').innerText='✓ Image loaded successfully';"
                                            />
                                        </div>
                                        <div style="font-size: 0.85rem; color: var(--gray-600); line-height: 1.4;">
                                            <p style="margin: 0 0 6px 0;"><strong>Quick Presets:</strong> Click any preset to test:</p>
                                            <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                                                <button type="button" class="btn btn-secondary btn-sm" style="font-size: 0.75rem; padding: 3px 8px;" onclick="setImageUrl('https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=800&auto=format&fit=crop&q=80')">🎧 Headphones</button>
                                                <button type="button" class="btn btn-secondary btn-sm" style="font-size: 0.75rem; padding: 3px 8px;" onclick="setImageUrl('https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=800&auto=format&fit=crop&q=80')">⌚ Smart Watch</button>
                                                <button type="button" class="btn btn-secondary btn-sm" style="font-size: 0.75rem; padding: 3px 8px;" onclick="setImageUrl('https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=800&auto=format&fit=crop&q=80')">👟 Sneakers</button>
                                                <button type="button" class="btn btn-secondary btn-sm" style="font-size: 0.75rem; padding: 3px 8px;" onclick="setImageUrl('https://images.unsplash.com/photo-1526170375885-4d8ecf77b99f?w=800&auto=format&fit=crop&q=80')">📷 Camera</button>
                                                <button type="button" class="btn btn-secondary btn-sm" style="font-size: 0.75rem; padding: 3px 8px;" onclick="setImageUrl('https://images.unsplash.com/photo-1585386959984-a4155224a1ad?w=800&auto=format&fit=crop&q=80')">🧴 Perfume</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 32px; border-top: 1px solid var(--gray-200); padding-top: 20px;">
                                <a href="/admin/products" style="color: var(--gray-600);">&larr; Back to Products</a>
                                <button type="submit" class="btn btn-primary" id="btn-save-product">
                                    <%= isEdit ? 'Update Product' : 'Create Product' %>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>

    <script>
        const imageUrlInput = document.getElementById('imageUrl');
        const imgPreview = document.getElementById('img-preview');
        const previewStatus = document.getElementById('preview-status');

        function updatePreview(url) {
            const trimmed = (url || '').trim();
            if (trimmed) {
                previewStatus.innerText = 'Loading image...';
                imgPreview.src = trimmed;
            } else {
                imgPreview.src = 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500&auto=format&fit=crop&q=80';
                previewStatus.innerText = '(Using default placeholder)';
            }
        }

        function setImageUrl(url) {
            if (imageUrlInput) {
                imageUrlInput.value = url;
                updatePreview(url);
            }
        }

        if (imageUrlInput) {
            imageUrlInput.addEventListener('input', (e) => {
                updatePreview(e.target.value);
            });
            imageUrlInput.addEventListener('change', (e) => {
                updatePreview(e.target.value);
            });
        }
    </script>
</body>
</html>
