<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="main-content">
        <div class="container">
            <div class="flash-container">
                <%- include('../partials/messages') %>
            </div>

            <div class="admin-layout">
                <!-- Sidebar -->
                <aside class="admin-sidebar">
                    <ul class="admin-menu">
                        <li class="admin-menu-item"><a href="/admin" class="admin-menu-link">📊 Dashboard</a></li>
                        <li class="admin-menu-item"><a href="/admin/products" class="admin-menu-link active">📦 Products</a></li>
                        <li class="admin-menu-item"><a href="/admin/categories" class="admin-menu-link">📁 Categories</a></li>
                        <li class="admin-menu-item"><a href="/admin/orders" class="admin-menu-link">🛍️ Orders</a></li>
                        <li class="admin-menu-item"><a href="/admin/users" class="admin-menu-link">👥 Users</a></li>
                    </ul>
                </aside>

                <!-- Content -->
                <div class="admin-main">
                    <div class="page-action-header">
                        <h1>Product Catalog</h1>
                        <a href="/admin/products/new" class="btn btn-primary" id="btn-admin-add-product">+ Add Product</a>
                    </div>

                    <% if (products && products.length > 0) { %>
                        <div class="card" style="padding: 0; overflow: hidden;">
                            <div class="table-responsive">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Image</th>
                                            <th>Product Name</th>
                                            <th>Category</th>
                                            <th>Price</th>
                                            <th>Stock</th>
                                            <th>Rating</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% products.forEach(product => { %>
                                            <tr>
                                                <td>
                                                    <img 
                                                        src="<%= (product.images && product.images.length > 0) ? product.images[0] : 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=80&auto=format&fit=crop&q=80' %>" 
                                                        alt="" 
                                                        style="width: 44px; height: 44px; object-fit: cover; border-radius: 6px;"
                                                        onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=80&auto=format&fit=crop&q=80';"
                                                    />
                                                </td>
                                                <td style="font-weight: 600;"><%= product.name %></td>
                                                <td><%= product.category ? product.category.name : 'Uncategorized' %></td>
                                                <td>₹<%= product.price.toFixed(2) %></td>
                                                <td>
                                                    <span style="font-weight: 600; color: <%= product.stock > 0 ? '#10b981' : '#ef4444' %>;">
                                                        <%= product.stock %>
                                                    </span>
                                                </td>
                                                <td>★ <%= product.rating.toFixed(1) %></td>
                                                <td>
                                                    <div style="display: flex; gap: 8px;">
                                                        <a href="/admin/products/<%= product._id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
                                                        <form action="/admin/products/<%= product._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                                             <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Pagination -->
                        <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                            <div class="pagination">
                                <% for (let i = 1; i <= totalPages; i++) { %>
                                    <a href="/admin/products?page=<%= i %>" class="pagination-item <%= (typeof currentPage !== 'undefined' && currentPage === i) ? 'active' : '' %>">
                                        <%= i %>
                                    </a>
                                <% } %>
                            </div>
                        <% } %>
                    <% } else { %>
                        <div class="card" style="text-align: center; padding: 48px;">
                            <h3>No products added yet</h3>
                            <p style="color: var(--gray-500); margin: 12px 0 20px;">Click the button below to add your first product.</p>
                            <a href="/admin/products/new" class="btn btn-primary">+ Add New Product</a>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
