<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="main-content">
        <div class="container">
            <div class="flash-container">
                <%- include('../partials/messages') %>
            </div>

            <div class="admin-layout">
                <!-- Sidebar -->
                <aside class="admin-sidebar">
                    <ul class="admin-menu">
                        <li class="admin-menu-item"><a href="/admin" class="admin-menu-link">📊 Dashboard</a></li>
                        <li class="admin-menu-item"><a href="/admin/products" class="admin-menu-link">📦 Products</a></li>
                        <li class="admin-menu-item"><a href="/admin/categories" class="admin-menu-link active">📁 Categories</a></li>
                        <li class="admin-menu-item"><a href="/admin/orders" class="admin-menu-link">🛍️ Orders</a></li>
                        <li class="admin-menu-item"><a href="/admin/users" class="admin-menu-link">👥 Users</a></li>
                    </ul>
                </aside>

                <!-- Content -->
                <div class="admin-main">
                    <div class="page-action-header">
                        <h1>Category Management</h1>
                        <a href="/admin/categories/new" class="btn btn-primary" id="btn-admin-add-category">+ Add Category</a>
                    </div>

                    <% if (categories && categories.length > 0) { %>
                        <div class="card" style="padding: 0; overflow: hidden;">
                            <div class="table-responsive">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Slug</th>
                                            <th>Description</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% categories.forEach(cat => { %>
                                            <tr>
                                                <td style="font-weight: 600;"><%= cat.name %></td>
                                                <td><code><%= cat.slug %></code></td>
                                                <td style="color: var(--gray-600);"><%= cat.description || 'No description' %></td>
                                                <td>
                                                    <div style="display: flex; gap: 8px;">
                                                        <a href="/admin/categories/<%= cat._id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
                                                        <form action="/admin/categories/<%= cat._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this category?');">
                                                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="card" style="text-align: center; padding: 48px;">
                            <h3>No categories found</h3>
                            <p style="color: var(--gray-500); margin: 12px 0 20px;">Add your first category to start organizing products.</p>
                            <a href="/admin/categories/new" class="btn btn-primary">+ Add Category</a>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
