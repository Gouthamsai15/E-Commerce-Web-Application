<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="main-content">
        <div class="container">
            <div class="flash-container">
                <%- include('../partials/messages') %>
            </div>

            <div class="admin-layout">
                <!-- Sidebar -->
                <aside class="admin-sidebar">
                    <ul class="admin-menu">
                        <li class="admin-menu-item"><a href="/admin" class="admin-menu-link">📊 Dashboard</a></li>
                        <li class="admin-menu-item"><a href="/admin/products" class="admin-menu-link">📦 Products</a></li>
                        <li class="admin-menu-item"><a href="/admin/categories" class="admin-menu-link">📁 Categories</a></li>
                        <li class="admin-menu-item"><a href="/admin/orders" class="admin-menu-link active">🛍️ Orders</a></li>
                        <li class="admin-menu-item"><a href="/admin/users" class="admin-menu-link">👥 Users</a></li>
                    </ul>
                </aside>

                <!-- Content -->
                <div class="admin-main">
                    <div class="page-action-header">
                        <h1>Manage Order #<%= order._id.toString().slice(-8).toUpperCase() %></h1>
                        <a href="/admin/orders" class="btn btn-secondary btn-sm">&larr; Back to Orders</a>
                    </div>

                    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 24px; align-items: start;">
                        <!-- Left: Items and Customer Info -->
                        <div>
                            <div class="card" style="padding: 0; overflow: hidden; margin-bottom: 24px;">
                                <div style="padding: 16px 20px; border-bottom: 1px solid var(--gray-200); font-weight: 700;">
                                    Order Items
                                </div>
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Product</th>
                                            <th>Unit Price</th>
                                            <th>Qty</th>
                                            <th>Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% order.items.forEach(item => { %>
                                            <tr>
                                                <td style="font-weight: 600;"><%= item.name %></td>
                                                <td>₹<%= item.price.toFixed(2) %></td>
                                                <td><%= item.quantity %></td>
                                                <td style="font-weight: 700; color: var(--primary);">₹<%= item.subtotal.toFixed(2) %></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>

                            <div class="card">
                                <h2 style="font-size: 1.15rem; margin-bottom: 12px;">Customer Details</h2>
                                <p style="font-size: 0.95rem; line-height: 1.6; color: var(--gray-700);">
                                    <strong>Name:</strong> <%= order.user ? order.user.name : 'Unknown User' %><br />
                                    <strong>Email:</strong> <%= order.user ? order.user.email : 'N/A' %><br />
                                </p>

                                <h2 style="font-size: 1.15rem; margin: 16px 0 12px; border-top: 1px solid var(--gray-200); padding-top: 12px;">
                                    Shipping Destination
                                </h2>
                                <p style="font-size: 0.95rem; line-height: 1.6; color: var(--gray-700);">
                                    <strong><%= order.shippingAddress.fullName %></strong><br />
                                    <%= order.shippingAddress.street %><br />
                                    <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.postalCode %><br />
                                    <%= order.shippingAddress.country %><br />
                                    Phone: <%= order.shippingAddress.phone %>
                                </p>
                            </div>
                        </div>

                        <!-- Right: Status Update Controls -->
                        <div class="card">
                            <h2 style="font-size: 1.15rem; margin-bottom: 16px; border-bottom: 1px solid var(--gray-200); padding-bottom: 8px;">
                                Update Status
                            </h2>

                            <form action="/admin/orders/<%= order._id %>/status" method="POST">
                                <div class="form-group">
                                    <label class="form-label">Order Fulfillment Status</label>
                                    <select name="orderStatus" class="form-control">
                                        <% Object.values(orderStatuses).forEach(st => { %>
                                            <option value="<%= st %>" <%= order.orderStatus === st ? 'selected' : '' %>><%= st %></option>
                                        <% }) %>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Payment Status</label>
                                    <select name="paymentStatus" class="form-control">
                                        <% Object.values(paymentStatuses).forEach(ps => { %>
                                            <option value="<%= ps %>" <%= order.paymentStatus === ps ? 'selected' : '' %>><%= ps %></option>
                                        <% }) %>
                                    </select>
                                </div>

                                <div style="display: flex; justify-content: space-between; font-size: 1.1rem; font-weight: 700; margin: 20px 0;">
                                    <span>Total:</span>
                                    <span style="color: var(--primary);">₹<%= order.totalAmount.toFixed(2) %></span>
                                </div>

                                <button type="submit" class="btn btn-primary btn-block">Save Status Changes</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
