<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="main-content">
        <div class="container">
            <div class="flash-container">
                <%- include('../partials/messages') %>
            </div>

            <div class="admin-layout">
                <!-- Admin Navigation Sidebar -->
                <aside class="admin-sidebar">
                    <h3 style="font-size: 1rem; margin-bottom: 16px; color: var(--gray-500); text-transform: uppercase;">
                        Admin Portal
                    </h3>
                    <ul class="admin-menu">
                        <li class="admin-menu-item">
                            <a href="/admin" class="admin-menu-link active">📊 Dashboard</a>
                        </li>
                        <li class="admin-menu-item">
                            <a href="/admin/products" class="admin-menu-link">📦 Products</a>
                        </li>
                        <li class="admin-menu-item">
                            <a href="/admin/categories" class="admin-menu-link">📁 Categories</a>
                        </li>
                        <li class="admin-menu-item">
                            <a href="/admin/orders" class="admin-menu-link">🛍️ Orders</a>
                        </li>
                        <li class="admin-menu-item">
                            <a href="/admin/users" class="admin-menu-link">👥 Users</a>
                        </li>
                    </ul>
                </aside>

                <!-- Admin Main Content -->
                <div class="admin-main">
                    <h1 style="margin-bottom: 24px;">Admin Analytics & Overview</h1>

                    <!-- Stats Cards -->
                    <div class="stats-grid">
                        <div class="stat-card">
                            <div class="stat-label">Total Revenue</div>
                            <div class="stat-value" style="color: #10b981;">₹<%= totalRevenue.toFixed(2) %></div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">Total Orders</div>
                            <div class="stat-value"><%= totalOrders %></div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">Total Products</div>
                            <div class="stat-value"><%= totalProducts %></div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">Registered Users</div>
                            <div class="stat-value"><%= totalUsers %></div>
                        </div>
                    </div>

                    <!-- Recent Orders Card -->
                    <div class="card" style="padding: 0; overflow: hidden;">
                        <div style="display: flex; justify-content: space-between; align-items: center; padding: 18px 24px; border-bottom: 1px solid var(--gray-200);">
                            <h2 style="font-size: 1.15rem; margin: 0;">Recent Customer Orders</h2>
                            <a href="/admin/orders" class="btn btn-secondary btn-sm">View All Orders</a>
                        </div>

                        <% if (recentOrders && recentOrders.length > 0) { %>
                            <div class="table-responsive">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Order #</th>
                                            <th>Customer</th>
                                            <th>Date</th>
                                            <th>Amount</th>
                                            <th>Status</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% recentOrders.forEach(order => { %>
                                            <tr>
                                                <td style="font-weight: 600;">#<%= order._id.toString().slice(-8).toUpperCase() %></td>
                                                <td><%= order.user ? order.user.name : 'Unknown' %></td>
                                                <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                                                <td style="font-weight: 700; color: var(--primary);">₹<%= order.totalAmount.toFixed(2) %></td>
                                                <td>
                                                    <span class="status-pill status-<%= order.orderStatus %>">
                                                        <%= order.orderStatus %>
                                                    </span>
                                                </td>
                                                <td>
                                                    <a href="/admin/orders/<%= order._id %>" class="btn btn-secondary btn-sm">Manage</a>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } else { %>
                            <p style="padding: 32px; text-align: center; color: var(--gray-500);">No orders placed yet.</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
