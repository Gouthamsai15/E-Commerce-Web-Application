<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/product.css" />
</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="main-content">
        <div class="container">
            <div class="flash-container">
                <%- include('../partials/messages') %>
            </div>

            <!-- Breadcrumbs -->
            <div style="margin-bottom: 20px; font-size: 0.9rem; color: var(--gray-500);">
                <a href="/">Home</a> / 
                <a href="/products">Products</a> / 
                <% if (product.category) { %>
                    <a href="/products?category=<%= product.category.slug || product.category._id %>"><%= product.category.name %></a> /
                <% } %>
                <span style="color: var(--gray-800);"><%= product.name %></span>
            </div>

            <!-- Product Details Section -->
            <div class="product-detail-layout">
                <!-- Gallery Image -->
                <div class="product-gallery">
                    <img 
                        src="<%= (product.images && product.images.length > 0) ? product.images[0] : 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=800&auto=format&fit=crop&q=80' %>" 
                        alt="<%= product.name %>" 
                        id="main-product-image"
                    />
                </div>

                <!-- Product Information & Purchase Form -->
                <div class="product-info-panel">
                    <span class="product-category-tag">
                        <%= product.category ? product.category.name : 'General' %>
                    </span>
                    <h1><%= product.name %></h1>

                    <div class="product-rating">
                        <span>★ <%= product.rating ? product.rating.toFixed(1) : '5.0' %></span>
                        <span class="review-count">(<%= product.numberOfReviews || 0 %> customer reviews)</span>
                    </div>

                    <div class="product-detail-price">
                        ₹<%= product.price.toFixed(2) %>
                    </div>

                    <p class="product-detail-desc"><%= product.description %></p>

                    <div class="stock-indicator <%= product.stock > 0 ? 'in-stock' : 'out-of-stock' %>">
                        <%= product.stock > 0 ? `● In Stock (${product.stock} units available)` : '● Currently Out of Stock' %>
                    </div>

                    <!-- Add to Cart Form -->
                    <form action="/cart/add" method="POST" style="margin-top: 24px;" id="add-to-cart-form">
                        <input type="hidden" name="productId" value="<%= product._id %>" />

                        <div style="display: flex; gap: 16px; align-items: center; margin-bottom: 20px;">
                            <label for="quantity-select" style="font-weight: 600;">Quantity:</label>
                            <input 
                                type="number" 
                                id="quantity-select" 
                                name="quantity" 
                                value="1" 
                                min="1" 
                                max="<%= Math.max(1, product.stock) %>" 
                                class="form-control" 
                                style="width: 80px;"
                                <%= product.stock <= 0 ? 'disabled' : '' %>
                            />
                        </div>

                        <button 
                            type="submit" 
                            class="btn btn-primary" 
                            style="padding: 14px 28px; font-size: 1.05rem;"
                            id="btn-add-to-cart"
                            <%= product.stock <= 0 ? 'disabled' : '' %>
                        >
                            🛒 <%= product.stock > 0 ? 'Add to Cart' : 'Sold Out' %>
                        </button>
                    </form>
                </div>
            </div>

            <!-- Customer Reviews Section -->
            <div class="reviews-section">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                    <h2>Customer Reviews (<%= reviews.length %>)</h2>
                    <span style="font-size: 1.1rem; font-weight: 700; color: var(--warning);">
                        ★ <%= product.rating ? product.rating.toFixed(1) : '5.0' %> / 5.0
                    </span>
                </div>

                <!-- Review Form for Logged-in Users -->
                <% if (typeof user !== 'undefined' && user) { %>
                    <div class="card" style="background: var(--gray-50); margin-bottom: 32px;">
                        <h3 style="margin-bottom: 12px;">Write a Review</h3>
                        <form action="/products/<%= product._id %>/review" method="POST" id="submit-review-form">
                            <div class="form-group">
                                <label for="rating-select" class="form-label">Rating</label>
                                <select name="rating" id="rating-select" class="form-control" style="width: auto;" required>
                                    <option value="5">★★★★★ (5 - Excellent)</option>
                                    <option value="4">★★★★☆ (4 - Good)</option>
                                    <option value="3">★★★☆☆ (3 - Average)</option>
                                    <option value="2">★★☆☆☆ (2 - Poor)</option>
                                    <option value="1">★☆☆☆☆ (1 - Terrible)</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="review-comment" class="form-label">Your Review Feedback</label>
                                <textarea 
                                    name="comment" 
                                    id="review-comment" 
                                    rows="3" 
                                    class="form-control" 
                                    placeholder="Share what you liked or disliked about this product..."
                                    required
                                ></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary btn-sm" id="btn-submit-review">Submit Review</button>
                        </form>
                    </div>
                <% } else { %>
                    <div class="card" style="background: var(--gray-50); text-align: center; padding: 20px; margin-bottom: 32px;">
                        <p>Please <a href="/auth/login?redirect=/products/<%= product._id %>">Sign In</a> to write a customer review.</p>
                    </div>
                <% } %>

                <!-- Review List -->
                <% if (reviews && reviews.length > 0) { %>
                    <div>
                        <% reviews.forEach(review => { %>
                            <div class="review-item" id="review-<%= review._id %>">
                                <div class="review-header">
                                    <span class="review-author"><%= review.user ? review.user.name : 'Verified Customer' %></span>
                                    <span class="review-date"><%= new Date(review.createdAt).toLocaleDateString() %></span>
                                </div>
                                <div style="color: var(--warning); margin-bottom: 6px;">
                                    <% for (let i = 0; i < review.rating; i++) { %>★<% } %>
                                </div>
                                <p style="color: var(--gray-700);"><%= review.comment %></p>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p style="color: var(--gray-500); text-align: center; padding: 20px 0;">No reviews yet. Be the first to review this product!</p>
                <% } %>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
