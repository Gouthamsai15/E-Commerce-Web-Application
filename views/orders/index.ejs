<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="main-content">
        <div class="container">
            <div class="flash-container">
                <%- include('../partials/messages') %>
            </div>

            <h1 style="margin-bottom: 24px;">Your Order History</h1>

            <% if (orders && orders.length > 0) { %>
                <div class="card" style="padding: 0; overflow: hidden;">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Order #</th>
                                    <th>Date</th>
                                    <th>Items</th>
                                    <th>Total Amount</th>
                                    <th>Payment Status</th>
                                    <th>Order Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% orders.forEach(order => { %>
                                    <tr>
                                        <td style="font-weight: 700;">#<%= order._id.toString().slice(-8).toUpperCase() %></td>
                                        <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                                        <td><%= order.items.length %> item(s)</td>
                                        <td style="font-weight: 700; color: var(--primary);">₹<%= order.totalAmount.toFixed(2) %></td>
                                        <td>
                                            <span class="status-pill status-<%= order.paymentStatus %>">
                                                <%= order.paymentStatus %>
                                            </span>
                                        </td>
                                        <td>
                                            <span class="status-pill status-<%= order.orderStatus %>">
                                                <%= order.orderStatus %>
                                            </span>
                                        </td>
                                        <td>
                                            <a href="/orders/<%= order._id %>" class="btn btn-secondary btn-sm">View Details</a>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } else { %>
                <div class="card" style="text-align: center; padding: 48px;">
                    <h3>No orders yet</h3>
                    <p style="color: var(--gray-500); margin: 12px 0 20px;">You haven't placed any orders with us yet.</p>
                    <a href="/products" class="btn btn-primary">Start Shopping</a>
                </div>
            <% } %>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
