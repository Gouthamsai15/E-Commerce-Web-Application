<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/auth.css" />
</head>
<body>
    <%- include('../partials/navbar') %>

    <main class="main-content">
        <div class="container">
            <div class="flash-container">
                <%- include('../partials/messages') %>
            </div>

            <div style="max-width: 680px; margin: 0 auto;">
                <div class="card">
                    <h1 style="font-size: 1.5rem; margin-bottom: 20px; border-bottom: 1px solid var(--gray-200); padding-bottom: 12px;">
                        Edit Profile
                    </h1>

                    <form action="/user/edit-profile" method="POST" id="edit-profile-form">
                        <div class="form-group">
                            <label for="name" class="form-label">Full Name</label>
                            <input 
                                type="text" 
                                id="name" 
                                name="name" 
                                class="form-control" 
                                value="<%= user.name || '' %>" 
                                required 
                            />
                        </div>

                        <div class="form-group">
                            <label for="email" class="form-label">Email Address (Read Only)</label>
                            <input 
                                type="email" 
                                id="email" 
                                class="form-control" 
                                value="<%= user.email || '' %>" 
                                disabled 
                                style="background-color: var(--gray-100);"
                            />
                        </div>

                        <div class="form-group">
                            <label for="phone" class="form-label">Phone Number</label>
                            <input 
                                type="text" 
                                id="phone" 
                                name="phone" 
                                class="form-control" 
                                value="<%= user.phone || '' %>" 
                            />
                        </div>

                        <h2 style="font-size: 1.15rem; margin: 24px 0 16px; border-top: 1px solid var(--gray-200); padding-top: 16px;">
                            Default Shipping Address
                        </h2>

                        <div class="form-group">
                            <label for="street" class="form-label">Street Address</label>
                            <input 
                                type="text" 
                                id="street" 
                                name="street" 
                                class="form-control" 
                                value="<%= (user.address && user.address.street) || '' %>" 
                            />
                        </div>

                        <div style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 16px;">
                            <div class="form-group">
                                <label for="city" class="form-label">City</label>
                                <input 
                                    type="text" 
                                    id="city" 
                                    name="city" 
                                    class="form-control" 
                                    value="<%= (user.address && user.address.city) || '' %>" 
                                />
                            </div>

                            <div class="form-group">
                                <label for="state" class="form-label">State</label>
                                <input 
                                    type="text" 
                                    id="state" 
                                    name="state" 
                                    class="form-control" 
                                    value="<%= (user.address && user.address.state) || '' %>" 
                                />
                            </div>

                            <div class="form-group">
                                <label for="postalCode" class="form-label">Postal Code</label>
                                <input 
                                    type="text" 
                                    id="postalCode" 
                                    name="postalCode" 
                                    class="form-control" 
                                    value="<%= (user.address && user.address.postalCode) || '' %>" 
                                />
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="country" class="form-label">Country</label>
                            <input 
                                type="text" 
                                id="country" 
                                name="country" 
                                class="form-control" 
                                value="<%= (user.address && user.address.country) || 'United States' %>" 
                            />
                        </div>

                        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 24px; border-top: 1px solid var(--gray-200); padding-top: 16px;">
                            <a href="/user/profile" style="color: var(--gray-600);">&larr; Cancel</a>
                            <button type="submit" class="btn btn-primary" id="btn-save-profile">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
